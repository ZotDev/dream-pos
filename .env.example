# Dream POS environment template
# Copy this file to .env.local for local development.
# Never commit real credentials or production secrets.

# Required for Neon/PostgreSQL connectivity
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Use a unique, cryptographically random secret (32+ bytes) for signed sessions.
# Example generation: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: unpooled Neon connection for migrations/administrative scripts
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional public app URL; only expose values safe for browsers.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
